.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/ .env

# ── Dependencies ──
node_modules/

# ── Build output ──
dist/
build/
frontend/dist/
.vite/

# ── Logs / debug ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test / coverage ──
coverage/
.nyc_output/

# ── OS / editor ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Misc secrets ──
*.pem
*.key
service-account*.json
