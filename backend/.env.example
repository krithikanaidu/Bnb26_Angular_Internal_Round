# Copy to .env: Copy-Item .env.example .env  (Supabase-only, no localhost DB)
# NEVER put real passwords or keys in this file - it is committed to git.
PORT=5000
# Supabase Dashboard > Project Settings > Database > Connection string > Transaction pooler (:6543)
# Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[REF].supabase.co
# service_role key from Dashboard - put ONLY in backend/.env (gitignored), never here
SUPABASE_SERVICE_KEY=[SERVICE_ROLE_KEY]
SUPABASE_BUCKET=creator-assets
# Optional AI (if empty, heuristic fallback is used - app still works)
AI_PROVIDER=heuristic
# OpenAI key (starts with sk-) — Whisper transcription + Scripts/Hooks AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Groq key (starts with gsk_) — viral titles (free tier). The app also
# accepts a Groq key pasted in OPENAI_API_KEY and routes it correctly.
# CLIPAI_GROQ_MODEL=openai/gpt-oss-20b
# ClipAI (ClippedAI port): viral titles via Groq, transcription via OpenAI Whisper.
# Both optional - heuristic fallbacks keep the pipeline working with no keys.
GROQ_API_KEY=
CLIPAI_MIN_CLIP_SEC=45
CLIPAI_MAX_CLIP_SEC=120
CLIPAI_PRESET=veryfast
CLIPAI_CRF=20
# CLIPAI_FFMPEG_PATH=
# CLIPAI_FFPROBE_PATH=
# CLIPAI_YTDLP_PATH=       # optional system yt-dlp override (bundled yt-dlp-exec otherwise)
# CLIPAI_YT_MAX_MIN=120    # refuse YouTube videos longer than this (0 = unlimited)
FRONTEND_URL=http://localhost:5173

# Signs login sessions (HS256 JWT). REQUIRED in production, >=16 chars.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
